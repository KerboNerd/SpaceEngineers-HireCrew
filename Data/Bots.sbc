<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Bots>
    <!-- Killable HireCrew gunner: clone of vanilla Astronaut with Invulnerable off for integrity/kill path. -->
    <Bot xsi:type="MyObjectBuilder_HumanoidBotDefinition">
      <Id>
        <TypeId>MyObjectBuilder_HumanoidBot</TypeId>
        <SubtypeId>HireCrew_Gunner</SubtypeId>
      </Id>
      <DisplayName>HireCrew Gunner</DisplayName>
      <Icon>Textures\GUI\Icons\SpawnDeer.dds</Icon>
      <BotModel>NPC_Astronaut</BotModel>
      <BotBehaviorTree Subtype="AstronautBehavior" />
      <BehaviorType>Astronaut</BehaviorType>
      <TargetType>Astronaut</TargetType>
      <BlockInteractionAnimation>PointForward</BlockInteractionAnimation>
      <PlayerGreetingAnimation>Wave</PlayerGreetingAnimation>
      <Public>true</Public>
      <AvailableInSurvival>true</AvailableInSurvival>
      <RemoveAfterDeath>true</RemoveAfterDeath>
      <InventoryContentGenerated>false</InventoryContentGenerated>
      <AttackLength>1000</AttackLength>
      <AttackRadius>0.5</AttackRadius>
      <CharacterDamage>0</CharacterDamage>
      <GridDamage>0</GridDamage>
      <TargetGrids>false</TargetGrids>
      <TargetCharacters>false</TargetCharacters>
      <AgentHeight>1.6</AgentHeight>
      <AgentRadius>0.4</AgentRadius>
      <AgentMaxClimb>0.45</AgentMaxClimb>
      <AgentMaxSlope>66</AgentMaxSlope>
      <PathArrivalRadius>0.05</PathArrivalRadius>
      <CanOpenDoors>true</CanOpenDoors>
      <UseFactionColor>true</UseFactionColor>
      <JoinSpawnerFaction>true</JoinSpawnerFaction>
      <DisableBroadcasting>true</DisableBroadcasting>
      <Invulnerable>false</Invulnerable>
      <IgnoredByAITargeting>false</IgnoredByAITargeting>
      <DoorOpenDistance>2.5</DoorOpenDistance>
      <SteeringBehaviors>
        <SteeringBehavior xsi:type="MyObjectBuilder_BotCharacterAvoidanceSteering">
          <Weight>0.35</Weight>
          <AvoidSameFactionOnly>false</AvoidSameFactionOnly>
          <DetectionRadius>1.5</DetectionRadius>
        </SteeringBehavior>
      </SteeringBehaviors>
    </Bot>
  </Bots>
</Definitions>
